# Copy to .env for local development. On Render, set these in the service's Environment tab instead.
# The server tries the local MySQL first (DB_*), then the online MySQL (ONLINE_DB_*).

# Local MySQL (defaults shown). The database is created automatically if your user is allowed to.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=powerlink

# Online MySQL (Aiven). Used when the local one cannot be reached, and on Render.
ONLINE_DB_HOST=
ONLINE_DB_PORT=
ONLINE_DB_USER=
ONLINE_DB_PASSWORD=
ONLINE_DB_NAME=defaultdb
ONLINE_DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# Optional: one connection string that skips the local attempt entirely.
# DATABASE_URL=mysql://user:password@host:port/database

# Must match the simulator's DEVICE_KEY. Change it when hosted.
DEVICE_KEY=powerlink-sim-key

# Only needed if the frontend is served from an origin other than localhost or the hosted frontend.
# CORS_ORIGINS=https://another-site.example
