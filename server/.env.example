# Optional. Copy to .env for local development. On Render, set these in the service's Environment tab instead.
# There is no database: the demo data is loaded into memory every time the server starts.

# Set to false to run the simulator as its own process (npm --prefix simulator start) instead of inside the server.
# RUN_SIMULATOR=true

# Only used by a standalone simulator. Must match the simulator's DEVICE_KEY.
DEVICE_KEY=powerlink-sim-key

# Demo timings (defaults shown).
# OUTAGE_DEBOUNCE_SECONDS=0
# LOADSHEDDING_GRACE_MINUTES=0
# OFFER_TIMEOUT_SECONDS=60

# Only needed if the frontend is served from an origin other than localhost or the hosted frontend.
# CORS_ORIGINS=https://another-site.example
